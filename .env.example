# ==========================================
# Database Configuration
# ==========================================
# For production (Railway), this can be updated to point to a Railway mounted volume or PostgreSQL.
DATABASE_URL="file:/app/data/prod.db"

# ==========================================
# NextAuth Configuration
# ==========================================
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key"
# Change this to your production domain (e.g. https://your-railway-app.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"

GROQ_API_KEY="your-groq-api-key"

# ==========================================
# Jira Webhook Configuration
# ==========================================
JIRA_WEBHOOK_SECRET="your-jira-webhook-secret"

# ==========================================
# Jira API Credentials
# ==========================================
JIRA_API_TOKEN="YOUR_API_TOKEN"
JIRA_EMAIL="your-atlassian-email@example.com" 

# ==========================================
# GitHub Analytics Credentials
# ==========================================
GITHUB_PAT="your-github-personal-access-token"
GITHUB_REPO="" # Please fill in your owner/repo (e.g. "facebook/react")
